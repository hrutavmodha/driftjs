<script>
  let count = 0;
  let history = [];
  let autoRunning = false;
  let _intervalId = null;

  function increment() {
    count++;
    history = [`Incremented to ${count}`, ...history];
  }

  function decrement() {
    count--;
    history = [`Decremented to ${count}`, ...history];
  }

  function reset() {
    count = 0;
    history = ['Reset counter to 0', ...history];
  }

  function clearHistory() {
    history = [];
  }

  function startAutoIncrement() {
    if (autoRunning) return;
    autoRunning = true;
    history = ['▶ Auto-increment started', ...history];
    _intervalId = setInterval(() => {
      count++;
      history = [`Auto → ${count}`, ...history];
    }, 1000);
  }

  function stopAutoIncrement() {
    if (!autoRunning) return;
    clearInterval(_intervalId);
    _intervalId = null;
    autoRunning = false;
    history = ['■ Auto-increment stopped', ...history];
  }

  function toggleAuto() {
    if (autoRunning) {
      stopAutoIncrement();
    } else {
      startAutoIncrement();
    }
  }
</script>

<div class="card">
  <div class="header">
    <div class="logo-badge">Powered by DriftJS</div>
    <p class="subtitle">A Register-based Virtual Machine</p>
    <h1>Basic Counter Application</h1>
  </div>

  <div class="counter-display">
    <span class="label">CURRENT COUNT</span>
    <div class="count-value">{count}</div>
    
    <div class="badge-container">
      @if count === 0 {
        <span class="badge badge-zero">Zero State</span>
      }
      @else if count > 0 {
        <span class="badge badge-positive">Positive (+{count})</span>
      }
      @else {
        <span class="badge badge-negative">Negative ({count})</span>
      }

      @if count % 2 === 0 {
        <span class="badge badge-even">Even</span>
      }
      @else {
        <span class="badge badge-odd">Odd</span>
      }
    </div>
  </div>

  <div class="button-group">
    <button class="btn btn-dec" onclick={decrement}>− Decrement</button>
    <button class="btn btn-reset" onclick={reset}>Reset</button>
    @if autoRunning {
      <button class="btn btn-auto btn-auto-stop" onclick={stopAutoIncrement}>■ Stop Auto</button>
    }
    @else {
      <button class="btn btn-auto" onclick={startAutoIncrement}>▶ Auto</button>
    }
    <button class="btn btn-inc" onclick={increment}>+ Increment</button>
  </div>

  <div class="history-section">
    <div class="history-header">
      <h2>Activity History Log</h2>
      <button class="btn-clear" onclick={clearHistory}>Clear Log</button>
    </div>
    <ul class="history-list">
      @for log in history {
        <li class="pill">{log}</li>
      }
    </ul>
  </div>
</div>