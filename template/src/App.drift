<script>
  let count = 0;
  let history = [];

  function increment() {
    count++;
    history = [...history, `Incremented to ${count}`];
  }

  function decrement() {
    count--;
    history = [...history, `Decremented to ${count}`];
  }

  function reset() {
    count = 0;
    history = [...history, 'Reset counter to 0'];
  }

  function clearHistory() {
    history = [];
  }
</script>

<div class="card">
  <div class="header">
    <div class="logo-badge">DriftJS</div>
    <h1>Counter App</h1>
    <p class="subtitle">100% CSP Compliant • SSR & Hydrated Engine</p>
  </div>

  <div class="counter-display">
    <span class="label">CURRENT COUNT</span>
    <div class="count-value">{count}</div>
    @if count % 2 === 0 {
      <span class="badge badge-even">Even Number</span>
    }
    @else {
      <span class="badge badge-odd">Odd Number</span>
    }
  </div>

  <div class="button-group">
    <button class="btn btn-dec" onclick={decrement}>−</button>
    <button class="btn btn-reset" onclick={reset}>Reset</button>
    <button class="btn btn-inc" onclick={increment}>+</button>
  </div>

  <div class="history-section">
    <div class="history-header">
      <h2>Event Activity Log</h2>
      <button class="btn-clear" onclick={clearHistory}>Clear</button>
    </div>
    <ul class="history-list">
      @for log in history {
        <li class="pill">{log}</li>
      }
    </ul>
  </div>
</div>