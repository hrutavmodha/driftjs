<script>
  import { UserContext, ThemeContext } from './context';

  const userStore = UserContext.inject();
  const themeStore = ThemeContext.inject();

  let name = userStore.user.name;
  let role = userStore.user.role;
  let avatar = userStore.user.avatar;
  let mode = themeStore.theme.mode;
  let accent = themeStore.theme.accentColor;

  userStore.subscribe((u) => {
    name = u.name;
    role = u.role;
    avatar = u.avatar;
  });

  themeStore.subscribe((t) => {
    mode = t.mode;
    accent = t.accentColor;
  });
</script>

<div class="user-card" style={{ borderLeft: '5px solid ' + accent }}>
  <div class="user-header">
    <span class="user-avatar">{avatar}</span>
    <div>
      <h3 class="user-name">{name}</h3>
      <span class="user-badge" style={{ background: accent + '1a', color: accent }}>{role}</span>
    </div>
  </div>
  <div class="user-meta">
    <p>Theme Mode: <strong>{mode}</strong></p>
    <p>Accent Color: <strong style={{ color: accent }}>{accent}</strong></p>
  </div>
</div>
