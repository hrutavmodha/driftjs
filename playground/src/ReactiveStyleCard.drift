<script>
  let boxColor = '#3b82f6';
  let textColor = '#ffffff';
  let radius = 12;
  let padding = 20;

  function handleColorChange(e) {
    boxColor = e.target.value;
  }

  function handleTextColorChange(e) {
    textColor = e.target.value;
  }

  function handleRadiusChange(e) {
    radius = Number(e.target.value) || 0;
  }

  function setPreset(color, text) {
    boxColor = color;
    textColor = text;
  }
</script>

<div class="css-tester-container">
  <div class="css-tester-controls">
    <div class="control-field">
      <label>Background Color:</label>
      <div class="input-with-color">
        <input 
          type="color" 
          value={boxColor} 
          onInput={handleColorChange} 
          class="color-picker-input"
        />
        <span class="color-hex-badge">{boxColor}</span>
      </div>
    </div>

    <div class="control-field">
      <label>Text Color:</label>
      <div class="input-with-color">
        <input 
          type="color" 
          value={textColor} 
          onInput={handleTextColorChange} 
          class="color-picker-input"
        />
        <span class="color-hex-badge">{textColor}</span>
      </div>
    </div>

    <div class="control-field">
      <label>Border Radius: {radius}px</label>
      <input 
        type="range" 
        min="0" 
        max="32" 
        value={radius} 
        onInput={handleRadiusChange}
        class="slider-input"
      />
    </div>

    <div class="preset-row">
      <button class="preset-btn" style="background: #10b981; color: white;" onClick={() => setPreset('#10b981', '#ffffff')}>Emerald</button>
      <button class="preset-btn" style="background: #8b5cf6; color: white;" onClick={() => setPreset('#8b5cf6', '#ffffff')}>Violet</button>
      <button class="preset-btn" style="background: #f97316; color: white;" onClick={() => setPreset('#f97316', '#ffffff')}>Orange</button>
      <button class="preset-btn" style="background: #ec4899; color: white;" onClick={() => setPreset('#ec4899', '#ffffff')}>Pink</button>
      <button class="preset-btn" style="background: #0f172a; color: #38bdf8;" onClick={() => setPreset('#0f172a', '#38bdf8')}>Midnight</button>
    </div>
  </div>

  <div class="css-tester-preview">
    <div 
      class="dynamic-preview-box" 
      style={"background-color: " + boxColor + "; color: " + textColor + "; border-radius: " + radius + "px; padding: " + padding + "px;"}
    >
      <div class="preview-inner">
        <h4>Live CSS Reactive Box</h4>
        <p>Dynamic Style: <code>background: {boxColor}</code> | <code>radius: {radius}px</code></p>
      </div>
    </div>
  </div>
</div>
