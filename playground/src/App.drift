<script>
  import { RouterContext, RouterView, RouterLink } from 'driftjs-router';
  import { CounterContext } from './context.js';
  import { router } from './routes';

  RouterContext.provide(router);

  let counterState = {
    counter: 0,
    historyLogs: [],
  };

  function increment() {
    counterState.counter++;
    counterState.historyLogs = ['Incremented to ' + counterState.counter, ...counterState.historyLogs.slice(0, 4)];
  }

  function decrement() {
    counterState.counter--;
    counterState.historyLogs = ['Decremented to ' + counterState.counter, ...counterState.historyLogs.slice(0, 4)];
  }

  function reset() {
    counterState.counter = 0;
    counterState.historyLogs = ['Reset counter to 0', ...counterState.historyLogs.slice(0, 4)];
  }

  CounterContext.provide({
    get counter() {
      return counterState.counter;
    },
    get historyLogs() {
      return counterState.historyLogs;
    },
    increment,
    decrement,
    reset,
  });

  let activePath = router.currentRoute.fullPath;
  let activeName = router.currentRoute.name || 'unnamed';

  if (router && typeof router.subscribe === 'function') {
    router.subscribe((to) => {
      activePath = to.fullPath;
      activeName = to.name || 'unnamed';
    });
  }

  function goBack() {
    router.back();
  }

  function goForward() {
    router.forward();
  }

  function navigateTo(path) {
    router.push(path);
  }
</script>

<div class="playground-layout">
  <header class="playground-header">
    <div class="brand-title">
      <span class="logo-mark">⚡</span>
      <div>
        <h1>DriftJS Playground</h1>
        <p class="subtitle">AOT Register Virtual Machine &amp; Native Client-Side Router</p>
      </div>
    </div>
    <div class="header-user-status">
      <span class="badge">v0.0.7 Active</span>
    </div>
  </header>

  <nav class="nav-bar">
    <RouterLink to="/" label="🏠 Home" class="nav-link" />
    <RouterLink to="/docs/intro" label="📚 Documentation" class="nav-link" />
    <RouterLink to="/pioneers" label="👤 Pioneers Directory" class="nav-link" />
    <RouterLink to="/benchmarks" label="⚡ Benchmarks" class="nav-link" />
    <RouterLink to="/roadmap" label="🗺️ Roadmap" class="nav-link" />
  </nav>

  <section class="router-inspector">
    <div class="inspector-path">
      <span>Active Route:</span>
      <code>{activePath}</code>
      <span>(Name: <em>{activeName}</em>)</span>
    </div>
    <div class="inspector-actions">
      <button class="btn-nav-action" onclick={goBack}>⬅ Back</button>
      <button class="btn-nav-action" onclick={goForward}>➡ Forward</button>
      <button class="btn-nav-action" onclick={() => navigateTo('/pioneers/ada?tab=achievements')}>Ada Profile</button>
      <button class="btn-nav-action" onclick={() => navigateTo('/docs/vm')}>VM Docs</button>
      <button class="btn-nav-action" onclick={() => navigateTo('/non-existent-page')}>404 Test</button>
    </div>
  </section>

  <main class="playground-body">
    <RouterView />
  </main>
</div>
