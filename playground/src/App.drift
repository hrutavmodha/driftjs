<script>
  let count = 0;
  let items = ['Alpha', 'Beta', 'Gamma'];
  let mode = 'all';

  function inc() { count++; }
  function dec() { count--; }
  function reset() { count = 0; }

  function addItem() {
    let newName = `Item ${items.length + 1}`;
    items = [...items, newName];
  }

  function removeItem(idx) {
    items = items.filter((_, i) => i !== idx);
  }

  function setMode(newMode) {
    mode = newMode;
  }
</script>

<div>
  <h1>DriftJS Functionality Playground</h1>

  <section>
    <h2>1. Counter and Conditionals</h2>
    <p>Current Value: <strong>{count}</strong></p>
    <button onclick={inc}>Increment (+1)</button>
    <button onclick={dec}>Decrement (-1)</button>
    <button onclick={reset}>Reset (0)</button>

    <div>
      <p>
        Value Status: 
        @if count > 0 {
          <strong>Positive</strong>
        }
        @else if count < 0 {
          <strong>Negative</strong>
        }
        @else {
          <strong>Zero</strong>
        }
      </p>

      <p>
        Parity Status: 
        @if count % 2 === 0 {
          <strong>Even Number</strong>
        }
        @else {
          <strong>Odd Number</strong>
        }
      </p>
    </div>
  </section>

  <hr />

  <section>
    <h2>2. Dynamic List Reconciliation</h2>
    <p>Total Items: <strong>{items.length}</strong></p>
    <button onclick={addItem}>Add Item</button>

    <ul>
      @for (item, idx) in items {
        <li>
          #{idx + 1}: {item}
          <button onclick={() => removeItem(idx)}>Delete</button>
        </li>
      }
    </ul>
  </section>

  <hr />

  <section>
    <h2>3. Pattern Matching</h2>
    <p>Selected Filter Mode: <strong>{mode}</strong></p>

    <button onclick={() => setMode('all')}>Mode: all</button>
    <button onclick={() => setMode('active')}>Mode: active</button>
    <button onclick={() => setMode('completed')}>Mode: completed</button>

    <div>
      @switch mode {
        @case 'all' {
          <p>Showing ALL items in workspace.</p>
        }
        @case 'active' {
          <p>Showing ACTIVE items only.</p>
        }
        @default {
          <p>Showing OTHER / COMPLETED mode.</p>
        }
      }
    </div>
  </section>
</div>
