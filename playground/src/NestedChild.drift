<script>
  import { ThemeContext, UserContext } from './context';

  const themeStore = ThemeContext.inject();
  const userStore = UserContext.inject();

  let mode = themeStore.theme.mode;
  let accent = themeStore.theme.accentColor;
  let userName = userStore.user.name;

  themeStore.subscribe((t) => {
    mode = t.mode;
    accent = t.accentColor;
  });

  userStore.subscribe((u) => {
    userName = u.name;
  });
</script>

<div class="nested-box" style={{ borderLeft: '4px solid ' + accent }}>
  <h4>Deep Descendant Consumer</h4>
  <p>Inherited User: <strong>{userName}</strong></p>
  <p>Inherited Theme Mode: <strong>{mode}</strong></p>
  <p>Inherited Accent Color: <strong style={{ color: accent }}>{accent}</strong></p>
</div>
