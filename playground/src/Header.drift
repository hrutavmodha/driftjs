<script>
  import { UserContext, NotificationContext } from './context';

  let { title, subtitle } = props;
  const userStore = UserContext.inject();
  const noticeStore = NotificationContext.inject();

  let userName = userStore.user.name;
  let unread = noticeStore.notice.unreadCount;

  userStore.subscribe((u) => {
    userName = u.name;
  });

  noticeStore.subscribe((n) => {
    unread = n.unreadCount;
  });
</script>

<header class="playground-header">
  <div class="header-main">
    <h1>{title}</h1>
    <p class="subtitle">{subtitle}</p>
  </div>
  <div class="header-user-status">
    <span class="user-greeting">Signed in as <strong>{userName}</strong></span>
    <span class="badge">Live Alerts: {unread}</span>
  </div>
</header>