<script>
  import { UserContext, NotificationContext } from './context';

  let { title, subtitle } = props;
  const user = UserContext.inject();
  const notice = NotificationContext.inject();

  let userName = user.name;
  let unread = notice.unreadCount;
</script>

<header class="playground-header">
  <div class="header-main">
    <h1>{title}</h1>
    <p class="subtitle">{subtitle}</p>
  </div>
  <div class="header-user-status">
    <span class="user-greeting">Signed in as <strong>{userName}</strong></span>
    <span class="badge">Notifications: {unread}</span>
  </div>
</header>