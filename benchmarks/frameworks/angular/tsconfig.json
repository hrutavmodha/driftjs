{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": false,
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": false,
    "strict": true
  },
  "include": ["src/**/*.ts"]
}
