{
  "name": "driftjs-shared",
  "version": "0.0.7",
  "description": "Shared utilities, Context API, scope resolution helpers, and runtime evaluators for DriftJS.",
  "keywords": [
    "driftjs",
    "shared",
    "context-api",
    "scope",
    "evaluator",
    "utilities",
    "reactivity"
  ],
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index-es.js",
  "exports": {
    ".": {
      "import": "./dist/index-es.js",
      "require": "./dist/index-cjs.js"
    }
  },
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "prepublishOnly": "pnpm build && pnpm test"
  },
  "license": "MIT",
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
