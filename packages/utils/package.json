{
  "name": "driftjs-shared",
  "version": "0.0.13",
  "description": "Shared utilities, Context API, scope resolution helpers, and runtime evaluators for DriftJS.",
  "keywords": [
    "driftjs",
    "shared",
    "context-api",
    "scope",
    "evaluator",
    "utilities",
    "reactivity"
  ],
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index-cjs.js",
  "module": "./dist/index-es.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index-es.js",
      "require": "./dist/index-cjs.js",
      "default": "./dist/index-es.js"
    }
  },
  "scripts": {
    "build": "vite build",
    "test": "vitest run"
  },
  "license": "MIT",
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
