{
  "name": "driftjs-ssr",
  "version": "0.0.7",
  "description": "Headless Server-Side Rendering (SSR) register Virtual Machine and HTML serializer for DriftJS.",
  "keywords": [
    "driftjs",
    "ssr",
    "server-side-rendering",
    "html-serializer",
    "virtual-machine",
    "register-vm",
    "reactivity",
    "rendering"
  ],
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index-cjs.js",
  "module": "./dist/index-es.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index-es.js",
      "require": "./dist/index-cjs.js",
      "default": "./dist/index-es.js"
    }
  },
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "prepublishOnly": "pnpm build && pnpm test"
  },
  "license": "MIT",
  "dependencies": {
    "driftjs-compiler": "workspace:*",
    "driftjs-shared": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
