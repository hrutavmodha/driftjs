{
  "name": "create-drift",
  "version": "0.0.5",
  "description": "CLI scaffolding tool for DriftJS register VM applications",
  "type": "module",
  "files": [
    "bin",
    "dist",
    "template",
    "README.md"
  ],
  "bin": {
    "create-drift": "./bin/create-drift.js",
    "drift": "./bin/create-drift.js"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "prebuild": "node ../../scripts/template/copy.js",
    "build": "pnpm prebuild && vite build",
    "test": "vitest run",
    "prepublishOnly": "pnpm build && pnpm test",
    "postpack": "node ../../scripts/template/clean.js",
    "postpublish": "node ../../scripts/template/clean.js"
  },
  "dependencies": {
    "@clack/prompts": "^0.10.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
