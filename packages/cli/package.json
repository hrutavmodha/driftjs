{
  "name": "create-drift",
  "version": "0.0.13",
  "description": "Interactive CLI scaffolding tool for DriftJS register VM client and server applications.",
  "keywords": [
    "create-drift",
    "driftjs",
    "cli",
    "scaffolding",
    "starter",
    "template",
    "generator",
    "virtual-machine"
  ],
  "license": "MIT",
  "type": "module",
  "files": [
    "bin",
    "dist",
    "template",
    "README.md"
  ],
  "bin": {
    "create-drift": "./bin/create-drift.js",
    "drift": "./bin/create-drift.js"
  },
  "main": "./dist/index-cjs.js",
  "module": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "require": "./dist/index-cjs.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "vite build",
    "test": "vitest run"
  },
  "dependencies": {
    "@clack/prompts": "^0.10.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
