{
  "name": "driftjs-router",
  "version": "0.0.8",
  "description": "Client-side SPA router for DriftJS with history, hash, and memory drivers, dynamic route parameters, nested routes/outlets, scroll restoration, and navigation guards.",
  "keywords": [
    "driftjs",
    "router",
    "spa",
    "routing",
    "virtual-machine",
    "reactivity",
    "navigation"
  ],
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index-cjs.js",
  "module": "./dist/index-es.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index-es.js",
      "require": "./dist/index-cjs.js",
      "default": "./dist/index-es.js"
    }
  },
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "prepublishOnly": "pnpm build && pnpm test"
  },
  "license": "MIT",
  "dependencies": {
    "driftjs-dom": "workspace:*",
    "driftjs-shared": "workspace:*",
    "path-to-regexp": "^6.3.0"
  },
  "devDependencies": {
    "driftjs-compiler": "workspace:*",
    "driftjs-vite-plugin": "workspace:*",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
