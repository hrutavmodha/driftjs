<script>
  import { RouterContext } from '../router.js';
  import { onUnmount } from 'driftjs-shared';

  const router = RouterContext.inject();
  let to = props.to || '/';
  let replace = props.replace || false;
  let target = props.target || '_self';
  let rel = props.rel || '';
  let customClass = props.class || '';
  let label = props.label || props.title || '';
  let activeClass = '';
  let href = '';

  function updateLink() {
    if (!router) {
      href = typeof to === 'string' ? to : (to && to.path ? to.path : '#');
      activeClass = customClass;
      return;
    }
    href = router.resolve(to).href;
    const targetPath = router.resolve(to).path;
    const currentPath = router.currentRoute.path;
    if (currentPath === targetPath) {
      activeClass = (customClass ? customClass + ' ' : '') + ((props.activeClass || (router.options && router.options.linkActiveClass) || 'router-link-active') + ' ' + (props.exactActiveClass || (router.options && router.options.linkExactActiveClass) || 'router-link-exact-active'));
    } else if (targetPath !== '/' && (currentPath.startsWith(targetPath.endsWith('/') ? targetPath : targetPath + '/'))) {
      activeClass = (customClass ? customClass + ' ' : '') + (props.activeClass || (router.options && router.options.linkActiveClass) || 'router-link-active');
    } else {
      activeClass = customClass;
    }
  }

  updateLink();

  if (router && typeof router.subscribe === 'function') {
    const unsubscribe = router.subscribe(() => {
      updateLink();
    });
    if (typeof onUnmount === 'function') {
      onUnmount(() => {
        unsubscribe();
      });
    }
  }

  function handleClick(e) {
    if (e.defaultPrevented) return;
    if (e.button !== 0) return;
    if (target && target !== '_self') return;
    if (e.metaKey || e.altKey || e.ctrlKey || e.shiftKey) return;

    e.preventDefault();
    if (!router) return;
    if (replace) {
      router.replace(to);
    } else {
      router.push(to);
    }
  }
</script>

<a href={href} class={activeClass} target={target} rel={rel} onclick={handleClick}>
  {label}
</a>
