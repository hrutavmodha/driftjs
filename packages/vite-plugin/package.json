{
  "name": "driftjs-vite-plugin",
  "version": "0.0.7",
  "description": "Vite plugin for build-time compilation of DriftJS Single File Components (.drift) into executable ESM bytecode modules.",
  "keywords": [
    "driftjs",
    "vite",
    "vite-plugin",
    "plugin",
    "sfc",
    "compiler",
    "build-tool"
  ],
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index-es.js",
  "exports": {
    ".": {
      "import": "./dist/index-es.js",
      "require": "./dist/index-cjs.js"
    }
  },
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "prepublishOnly": "pnpm build && pnpm test"
  },
  "license": "MIT",
  "dependencies": {
    "driftjs-compiler": "workspace:*"
  },
  "peerDependencies": {
    "vite": "8.1.5"
  },
  "devDependencies": {
    "driftjs-dom": "workspace:*",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
