{
  "name": "driftjs-compiler",
  "version": "0.0.7",
  "description": "AOT compiler, lexer, parser, AST transformer, and register VM bytecode generator for DriftJS.",
  "keywords": [
    "driftjs",
    "compiler",
    "parser",
    "lexer",
    "ast",
    "bytecode",
    "virtual-machine",
    "aot-compiler",
    "reactivity",
    "ui"
  ],
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index-es.js",
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "prepublishOnly": "pnpm build && pnpm test"
  },
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index-es.js",
      "default": "./dist/index-es.js"
    }
  },
  "license": "MIT",
  "dependencies": {
    "acorn": "^8.17.0",
    "acorn-walk": "^8.3.4",
    "driftjs-shared": "workspace:*"
  },
  "devDependencies": {
    "@types/acorn": "^6.0.4",
    "@types/estree": "^1.0.6",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
