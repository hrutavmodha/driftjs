{
  "name": "driftjs-dom",
  "version": "0.0.11",
  "description": "High-performance register-based Virtual Machine and reconciler for client-side DOM rendering in DriftJS.",
  "keywords": [
    "driftjs",
    "dom",
    "client",
    "virtual-machine",
    "register-vm",
    "reactivity",
    "reconciler",
    "hydration",
    "ui"
  ],
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index-cjs.js",
  "module": "./dist/index-es.js",
  "types": "./src/index.ts",
  "scripts": {
    "build": "vite build",
    "test": "vitest run"
  },
  "dependencies": {
    "driftjs-shared": "workspace:*"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index-es.js",
      "require": "./dist/index-cjs.js",
      "default": "./dist/index-es.js"
    }
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
