{
  "name": "vscode-drift",
  "displayName": "DriftJS Language Support",
  "description": "Language server, IntelliSense, diagnostics, and syntax highlighting for DriftJS (.drift) Single File Components.",
  "version": "0.0.4",
  "publisher": "driftjs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hrutavmodha/driftjs.git"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "activationEvents": [
    "onLanguage:drift",
    "workspaceContains:**/*.drift",
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "drift",
        "aliases": ["DriftJS", "drift"],
        "extensions": [".drift"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "drift",
        "scopeName": "text.html.drift",
        "path": "./syntaxes/drift.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "drift",
        "path": "./snippets.json"
      }
    ]
  },
  "scripts": {
    "build": "vite build",
    "watch": "tsc -w",
    "test": "vitest run --passWithNoTests",
    "prepublishOnly": "pnpm build && pnpm test"
  },
  "dependencies": {
    "driftjs-compiler": "workspace:*",
    "vscode-languageclient": "^8.1.0",
    "vscode-languageserver": "^8.1.0",
    "vscode-languageserver-textdocument": "^1.0.8"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.75.0",
    "typescript": "^5.0.0",
    "vite": "^8.1.5"
  }
}
