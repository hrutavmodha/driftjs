{
  // Visit https://aka.ms/tsconfig to read more about this file
  "compilerOptions": {
    "paths": {
      "driftjs-compiler": ["./packages/compiler/src/index.ts"],
      "driftjs-compiler/*": ["./packages/compiler/*"],
      "driftjs-dom": ["./packages/dom/src/index.ts"],
      "driftjs-dom/*": ["./packages/dom/*"],
      "driftjs-ssr": ["./packages/ssr/src/index.ts"],
      "driftjs-ssr/*": ["./packages/ssr/*"],
      "driftjs-shared": ["./packages/utils/src/index.ts"],
      "driftjs-shared/*": ["./packages/utils/*"],
      "driftjs-vite-plugin": ["./packages/vite-plugin/src/index.ts"],
      "driftjs-vite-plugin/*": ["./packages/vite-plugin/*"],
      "driftjs-router": ["./packages/router/src/index.ts"],
      "driftjs-router/*": ["./packages/router/*"],
      "create-drift": ["./packages/cli/src/index.ts"],
      "create-drift/*": ["./packages/cli/*"],
      "driftjs-vscode": ["./packages/vscode-plugin/src/index.ts"],
      "driftjs-vscode/*": ["./packages/vscode-plugin/*"],
      "@driftjs/compiler": ["./packages/compiler/src/index.ts"],
      "@driftjs/compiler/*": ["./packages/compiler/*"],
      "@driftjs/dom": ["./packages/dom/src/index.ts"],
      "@driftjs/dom/*": ["./packages/dom/*"],
      "@driftjs/ssr": ["./packages/ssr/src/index.ts"],
      "@driftjs/ssr/*": ["./packages/ssr/*"],
      "@driftjs/utils": ["./packages/utils/src/index.ts"],
      "@driftjs/utils/*": ["./packages/utils/*"],
      "@driftjs/router": ["./packages/router/src/index.ts"],
      "@driftjs/router/*": ["./packages/router/*"],
      "@driftjs/vite-plugin": ["./packages/vite-plugin/src/index.ts"],
      "@driftjs/vite-plugin/*": ["./packages/vite-plugin/*"]
    },

    // Environment Settings
    "module": "nodenext",
    "target": "esnext",
    "types": [],

    // Other Outputs
    "noEmit": true,
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    // Stricter Typechecking Options
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    // Recommended Options
    "strict": true,
    "jsx": "react-jsx",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true
  }
}
